<?xml version="1.0" encoding="utf-8"?>
<!-- Aucune dépendance NuGet : le backend n'utilise que la bibliothèque standard .NET (exigence ET-20).
     La liste de sources est vide pour que la compilation fonctionne hors ligne.
     Pour ajouter une dépendance justifiée (ex. pilote SQL), retirer <clear /> ou déclarer la source interne. -->
<configuration><packageSources><clear /></packageSources></configuration>
