<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Même langage quel que soit le SDK (C# 12, celui du SDK 8) : le code se comporte pareil sur tous les cadres. -->
    <LangVersion>12.0</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Version livrée : affichée dans l'interface et renvoyée par /api/health. -->
    <Version>0.15.8</Version>
  </PropertyGroup>
</Project>
